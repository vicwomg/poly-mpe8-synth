<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dedicated Dark Dialog Theme for Native Select Popups and Alerts -->
    <style name="DarkAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">#161f2e</item>
        <item name="android:colorBackground">#161f2e</item>
        <item name="android:textColor">#f8fafc</item>
        <item name="android:textColorPrimary">#f8fafc</item>
        <item name="android:textColorAlertDialogListItem">#f8fafc</item>
        <item name="android:background">#161f2e</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DarkDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DarkDialogButton</item>
    </style>

    <style name="DarkDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#06b6d4</item>
    </style>

    <!-- Base application theme - Guaranteed Pure Dark Theme -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:background">@null</item>
        <item name="android:textColor">#f8fafc</item>
        <item name="android:textColorPrimary">#f8fafc</item>
        <item name="android:alertDialogTheme">@style/DarkAlertDialogTheme</item>
        <item name="alertDialogTheme">@style/DarkAlertDialogTheme</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Platform Android 12+ (API 31+) SplashScreen attributes -->
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#000000</item>

        <!-- AndroidX core-splashscreen compat attributes for API < 31 -->
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>

        <!-- System chrome and layout -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>